": {\n      \"$type\": \"duration\",\n      \"speed\": {\n        \"$value\": {\n          \"value\": 120,\n          \"unit\": \"ms\"\n        }\n      },\n      \"stagger\": {\n        \"$value\": {\n          \"value\": 30,\n          \"unit\": \"ms\"\n        }\n      }\n    },\n    \"easing\": {\n      \"$type\": \"cubicBezier\",\n      \"default\": {\n        \"$value\": [\n          0.2,\n          0.9,\n          0.25,\n          1\n        ],\n        \"$description\": \"Authored as `cubic-bezier(.2,.9,.25,1)`.\"\n      }\n    }\n  },\n  \"$extensions\": {\n    \"com.timothyvlangas.aesthetics\": {\n      \"format\": \"aesthetic/1\",\n      \"id\": \"hikari\",\n      \"name\": \"Hikari\",\n      \"status\": \"draft\",\n      \"corner\": \"round\",\n      \"effects\": {\n        \"gloss\": 0.3,\n        \"glass\": 6,\n        \"grain\": 0\n      },\n      \"decor\": {\n        \"ornament\": \"⬢\",\n        \"dividers\": \"line\",\n        \"underline\": \"solid\"\n      },\n      \"motion\": {\n        \"entrance\": \"grow\",\n        \"hover\": \"glow\",\n        \"ambient\": \"drift\",\n        \"easing\": \"cubic-bezier(.2,.9,.25,1)\"\n      },\n      \"texture\": {\n        \"kind\": \"grid\",\n        \"a\": \"#8FC4EE\",\n        \"b\": \"#DCE9F8\",\n        \"alpha\": 0.7,\n        \"notes\": \"The floor of the Net: a ruled grid of light, guardrails running to the horizon. After dark the same grid is navy on navy, which is what the toward() walk already does. Still wants two things the format can't say — horizontal scanlines at about 2px, and a bright dot travelling the traces.\"\n      },\n      \"source\": \"hikari.aesthetic.json\",\n      \"variants\": [\n        {\n          \"name\": \"Jacked out\",\n          \"mode\": \"light\",\n          \"roles\": {\n            \"bg\": \"#D8E6F7\",\n            \"surface\": \"#FBFDFF\",\n            \"ink\": \"#16324C\",\n            \"inkSoft\": \"#5A7894\",\n            \"line\": \"#9BB6CC\",\n            \